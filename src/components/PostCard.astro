---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  /** The first card on the home page gets a wider, taller treatment. */
  featured?: boolean;
  loading?: 'eager' | 'lazy';
}

const { post, featured = false, loading = 'lazy' } = Astro.props;
const { title, date, author, description, cover } = post.data;
const href = `/${post.id}/`;
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-xl border border-ink-800 bg-ink-850 transition-colors duration-200 hover:border-ink-600',
    featured && 'md:col-span-2 md:flex-row',
  ]}
>
  <div
    class:list={[
      'relative overflow-hidden bg-ink-800',
      featured ? 'aspect-16/10 md:aspect-auto md:w-1/2' : 'aspect-16/10',
    ]}
  >
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          widths={featured ? [480, 768, 1024] : [320, 480, 768]}
          sizes={featured ? '(min-width: 768px) 42vw, 100vw' : '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw'}
          loading={loading}
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-linear-to-br from-ink-800 to-ink-950">
          <span class="font-display text-5xl font-black text-ink-700">DD</span>
        </div>
      )
    }
    <div class="pointer-events-none absolute inset-0 bg-linear-to-t from-ink-950/60 to-transparent"></div>
  </div>

  <div class:list={['flex flex-1 flex-col p-5 md:p-6', featured && 'md:justify-center md:p-8']}>
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-400">
      <FormattedDate date={date} />
      {author && <><span class="text-ink-600">/</span><span>{author}</span></>}
    </div>

    <h3 class:list={['mt-3 font-bold leading-tight', featured ? 'text-2xl md:text-4xl' : 'text-xl']}>
      <a href={href} class="after:absolute after:inset-0 hover:text-brand-bright focus-visible:text-brand-bright">
        {title}
      </a>
    </h3>

    {
      description && (
        <p class:list={['mt-3 text-sm leading-relaxed text-ink-400', featured ? 'line-clamp-4' : 'line-clamp-3']}>
          {description}
        </p>
      )
    }

    <span
      class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-bright transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    >
      Weiterlesen
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</article>
