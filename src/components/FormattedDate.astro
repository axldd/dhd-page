---
interface Props {
  date: Date;
  class?: string;
}
const { date, class: className } = Astro.props;
const formatted = new Intl.DateTimeFormat('de-DE', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Berlin',
}).format(date);
---

<time datetime={date.toISOString()} class={className}>{formatted}</time>
