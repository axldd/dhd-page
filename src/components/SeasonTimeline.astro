---
import type { CollectionEntry } from 'astro:content';

interface Props {
  seasons: CollectionEntry<'seasons'>[];
}

const { seasons } = Astro.props;

const STATUS = {
  upcoming: { label: 'Geplant', dot: 'bg-brand', ring: 'ring-brand/30', text: 'text-brand-bright' },
  completed: { label: 'Gelaufen', dot: 'bg-ink-600', ring: 'ring-ink-700/50', text: 'text-ink-400' },
  canceled: { label: 'Abgesagt', dot: 'bg-ink-700', ring: 'ring-ink-800', text: 'text-ink-600' },
} as const;
---

<div class="space-y-16">
  {
    seasons.map((season) => (
      <section aria-labelledby={`season-${season.data.year}`}>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 id={`season-${season.data.year}`} class="text-2xl font-black md:text-3xl">
            {season.data.title}
          </h2>
          {/* Decorative year, only where it can sit beside the title. */}
          <span class="hidden font-display text-5xl font-black leading-none text-ink-850 sm:inline md:text-6xl" aria-hidden="true">
            {season.data.year}
          </span>
        </div>

        {season.data.note && (
          <p class="mt-2 inline-flex items-center gap-2 rounded-full border border-ink-700 px-3 py-1 text-xs font-semibold text-ink-300">
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 text-brand-bright" fill="currentColor" aria-hidden="true">
              <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 3a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm1 8H7V7h2v5Z" />
            </svg>
            {season.data.note}
          </p>
        )}

        <ol class="mt-6 border-l border-ink-800 pl-6 md:pl-8">
          {season.data.events.map((event) => {
            const s = STATUS[event.status];
            return (
              <li class="relative pb-7 last:pb-0">
                <span
                  class:list={['absolute -left-[calc(1.5rem+4.5px)] top-2 h-2 w-2 rounded-full ring-4 md:-left-[calc(2rem+4.5px)]', s.dot, s.ring]}
                  aria-hidden="true"
                />
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3
                    class:list={[
                      'text-lg font-bold',
                      event.status === 'canceled' ? 'text-ink-500 line-through' : 'text-ink-50',
                    ]}
                  >
                    {event.url ? (
                      <a href={event.url} class="hover:text-brand-bright">
                        {event.name}
                      </a>
                    ) : (
                      event.name
                    )}
                  </h3>
                  <span class:list={['text-xs font-bold uppercase tracking-wider', s.text]}>{s.label}</span>
                </div>
                <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-400">
                  {event.dates && <span class="font-semibold text-ink-300">{event.dates}</span>}
                  {event.location && <span>{event.location}</span>}
                  {event.points && (
                    <span class="rounded border border-ink-700 px-1.5 py-0.5 font-mono text-xs text-ink-300">
                      {event.points}
                    </span>
                  )}
                </p>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</div>
