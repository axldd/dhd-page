---
import { Image } from 'astro:assets';
import { load as parseYaml } from 'js-yaml';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import teamYaml from '../data/team.yaml?raw';

interface Member {
  name: string;
  email: string;
  photo: string;
  bio?: string;
}

const team = parseYaml(teamYaml) as Member[];

// Astro needs a static glob to resolve the portrait paths at build time.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/uploads/**/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photoOf = (rel: string) => photos[`../assets/${rel}`]?.default;
---

<Base
  title="Organisation"
  description="Downhill Deutschland vertritt Downhill Skateboarding und Streetluge innerhalb der Skateboardkommission des DRIV. Das sind die Menschen dahinter."
>
  <PageHeader eyebrow="Über uns" title="Organisation" />

  <div class="container-page py-14 md:py-20">
    <!-- Text copied verbatim from the old WordPress page. -->
    <section class="mx-auto max-w-3xl" aria-labelledby="was-wir-machen">
      <h2 id="was-wir-machen" class="text-2xl font-black md:text-3xl">Was wir machen</h2>
      <div class="mt-2 h-[3px] w-10 bg-brand" aria-hidden="true"></div>
      <p class="mt-6 leading-relaxed text-ink-300">
        Wir sind die Vertretung der Sportart Downhill Skateboarding und Streetluge innerhalb der
        Skateboardkommission des DRIV.
      </p>
      <p class="mt-4 leading-relaxed text-ink-300">
        Wir kümmern uns um das Erarbeiten eines Regelwerks für deutsche Downhill Skateboarding und
        Streetluge, die Führung einer nationalen Rangliste und das Management der deutschen
        Mannschaft für die Veranstaltungen von World Skate.
      </p>
    </section>

    <section class="mx-auto mt-16 max-w-3xl" aria-labelledby="wer-wir-sind">
      <h2 id="wer-wir-sind" class="text-2xl font-black md:text-3xl">Wer wir sind</h2>
      <div class="mt-2 h-[3px] w-10 bg-brand" aria-hidden="true"></div>

      <ul class="mt-10 space-y-10">
        {
          team.map((member) => {
            const photo = photoOf(member.photo);
            return (
              <li class="flex flex-col gap-5 sm:flex-row sm:gap-7">
                {photo && (
                  <Image
                    src={photo}
                    alt={member.name}
                    width={320}
                    densities={[1, 2]}
                    class="h-32 w-32 shrink-0 rounded-full object-cover ring-2 ring-ink-700"
                  />
                )}
                <div class="min-w-0">
                  <h3 class="text-lg font-bold text-ink-50">{member.name}</h3>
                  <a
                    href={`mailto:${member.email}`}
                    class="mt-0.5 inline-block break-all text-sm font-semibold text-brand-bright hover:text-ink-50"
                  >
                    {member.email}
                  </a>
                  {member.bio && <p class="mt-3 leading-relaxed text-ink-300">{member.bio}</p>}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>
  </div>
</Base>
