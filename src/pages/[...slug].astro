---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageHeader from '../components/PageHeader.astro';

/**
 * Every migrated post and top-level page lives at the root, exactly where
 * WordPress served it (/champions-2026/, /impressum/, ...). Community pages get
 * their own /community/<slug>/ route.
 */
export const getStaticPaths = (async () => {
  const posts = await getCollection('posts');
  const pages = await getCollection('pages');

  return [
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'post' as const } })),
    ...pages
      // /community/ has its own index route that lists the local crews.
      .filter((entry) => entry.id !== 'community' && entry.id !== 'kontakt')
      .map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'page' as const } })),
  ];
}) satisfies GetStaticPaths;

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
const isPost = kind === 'post';
const cover = entry.data.cover;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  ogImage={cover?.src}
  ogType={isPost ? 'article' : 'website'}
  publishedTime={isPost && 'date' in entry.data ? entry.data.date : undefined}
  author={isPost && 'author' in entry.data ? entry.data.author : undefined}
>
  {
    isPost ? (
      <article>
        <header class="border-b border-ink-800 bg-linear-to-b from-ink-950 to-ink-900">
          <div class="container-page py-12 md:py-16">
            <a
              href="/"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink-400 transition-colors hover:text-brand-bright"
            >
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 8H3M7 4 3 8l4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Alle News
            </a>
            <h1 class="mt-5 max-w-4xl text-4xl font-black leading-[1.05] md:text-6xl">{entry.data.title}</h1>
            <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold uppercase tracking-wider text-ink-400">
              {'date' in entry.data && <FormattedDate date={entry.data.date} />}
              {'author' in entry.data && entry.data.author && (
                <>
                  <span class="text-ink-600">/</span>
                  <span>{entry.data.author}</span>
                </>
              )}
            </p>
          </div>

          {cover && (
            <div class="container-page pb-12 md:pb-16">
              <Image
                src={cover}
                alt=""
                widths={[640, 1024, 1600]}
                sizes="(min-width: 1280px) 1216px, 100vw"
                loading="eager"
                fetchpriority="high"
                class="aspect-16/9 w-full rounded-xl object-cover"
              />
            </div>
          )}
        </header>

        <div class="container-page py-12 md:py-16">
          <div class="prose-dd mx-auto max-w-3xl">
            <Content />
          </div>
        </div>
      </article>
    ) : (
      <>
        {/* No lead here: the description is auto-derived from the body, so
            printing it would just repeat the opening paragraph. */}
        <PageHeader title={entry.data.title} />
        <div class="container-page py-12 md:py-16">
          <div class="prose-dd mx-auto max-w-3xl">
            <Content />
          </div>
        </div>
      </>
    )
  }
</Base>
