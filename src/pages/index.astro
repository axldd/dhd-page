---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import hero from '../assets/uploads/2026/03/grosserlach_samu.webp';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [latest, ...rest] = posts;

const seasons = (await getCollection('seasons')).sort((a, b) => b.data.year - a.data.year);
const currentSeason = seasons[0];
---

<Base title="Downhill Deutschland">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-ink-800">
    <Image
      src={hero}
      alt=""
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[62%_45%]"
    />
    <!-- Two soft gradients instead of a flat scrim: the photo stays a photo,
         the headline still lands on a dark, even area. -->
    <div
      class="absolute inset-0 -z-10 bg-linear-to-t from-ink-950 via-ink-950/75 via-45% to-ink-950/20"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-linear-to-r from-ink-950/85 via-ink-950/25 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="container-page flex min-h-[68svh] flex-col justify-end py-16 md:min-h-[78svh] md:py-24">
      <p class="eyebrow">
        <span class="h-px w-6 bg-brand-bright" aria-hidden="true"></span>
        Downhill Skateboarding &amp; Streetluge
      </p>
      <h1 class="mt-5 max-w-4xl text-5xl font-black leading-[0.95] sm:text-6xl md:text-8xl">
        Oben<br />geht’s<br /><span class="text-brand-bright">los.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
        Downhill Deutschland ist die Vertretung für Downhill Skateboarding und Streetluge in
        Deutschland — Regelwerk, nationale Rangliste und die deutsche Mannschaft.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/kalender/"
          class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-bright"
        >
          Events ansehen
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href="/ranking/"
          class="inline-flex items-center rounded-lg border border-ink-600 bg-ink-950/50 px-5 py-3 text-sm font-bold text-ink-50 backdrop-blur-sm transition-colors hover:border-brand hover:text-brand-bright"
        >
          Ranking
        </a>
      </div>
    </div>
  </section>

  <!-- Quick links -->
  <section class="border-b border-ink-800 bg-ink-950" aria-label="Schnellzugriff">
    <div class="container-page grid gap-px sm:grid-cols-3">
      {
        [
          {
            href: '/kalender/',
            title: currentSeason ? currentSeason.data.title : 'Events',
            body: currentSeason
              ? `${currentSeason.data.events.length} Rennen im Kalender`
              : 'Alle Rennen der Saison',
          },
          { href: '/regeln/', title: 'Regelwerk', body: 'Basierend auf World Skate und WGSF' },
          { href: '/community/', title: 'Community', body: 'Lokale Gruppen in ganz Deutschland' },
        ].map((item) => (
          <a
            href={item.href}
            class="group flex items-start gap-4 py-7 transition-colors hover:bg-ink-900 sm:px-6 sm:first:pl-0"
          >
            <span class="mt-1.5 h-8 w-1 shrink-0 rounded-full bg-brand transition-all group-hover:h-10" aria-hidden="true" />
            <span>
              <span class="block font-bold text-ink-50">{item.title}</span>
              <span class="mt-1 block text-sm text-ink-400">{item.body}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- News -->
  <section class="container-page py-16 md:py-24" aria-labelledby="news">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">
          <span class="h-px w-6 bg-brand-bright" aria-hidden="true"></span>
          Aktuelles
        </p>
        <h2 id="news" class="mt-3 text-3xl font-black md:text-5xl">News</h2>
      </div>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 text-sm font-semibold text-ink-400 transition-colors hover:text-brand-bright"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M3 3v2.5c4.14 0 7.5 3.36 7.5 7.5H13C13 7.7 8.3 3 3 3Zm0 4.5V10a3 3 0 0 1 3 3h2.5A5.5 5.5 0 0 0 3 7.5ZM4.5 10.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
          ></path>
        </svg>
        RSS-Feed
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {latest && <PostCard post={latest} featured loading="eager" />}
      {rest.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>
