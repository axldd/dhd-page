---
/**
 * WordPress 301'd /downhill-konstanz/ to the page's real location under
 * /community/. GitHub Pages can't serve a 301, so keep the URL alive with a
 * canonical + meta refresh.
 */
const target = '/community/downhill-konstanz/';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <title>Downhill Konstanz — Downhill Deutschland</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
  </head>
  <body style="background:#17191b;color:#e8eaeb;font-family:system-ui,sans-serif;padding:2rem">
    <p>Diese Seite ist umgezogen: <a href={target} style="color:#e0605d">{target}</a>.</p>
  </body>
</html>
